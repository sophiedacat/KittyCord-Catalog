{
    "api_version": 1,
    "id": "status-logger",
    "name": "Status Logger",
    "version": "1.0.0",
    "author": "KittyCord",
    "license": "MIT",
    "source": "https://github.com/ViceVerse-cz/KittyCord",
    "kind": "plugin",
    "capabilities": ["presence", "storage", "app_events"],
    "actions": [
        {
